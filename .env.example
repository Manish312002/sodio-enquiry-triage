# ---------------------------------------------------------------------------
# Sodio Enquiry Triage — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Real Grok / Gemini API calls are NOT required for Phase 0.
# ---------------------------------------------------------------------------

# --- Backend ---
NODE_ENV=development
PORT=3001

# --- MongoDB ---
# Local default shown below. Override with a remote URI if needed.
# Example local:   mongodb://127.0.0.1:27017/sodio_enquiry_triage
# Example remote:  mongodb+srv://<user>:<password>@<host>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sodio_enquiry_triage

# --- LLM providers (server-side ONLY — never expose to React) ---
# Phase 3 makes real HTTP calls when keys are present. Empty string means
# "not configured" — the provider is skipped (treated as NOT_CONFIGURED in
# the fallback chain), NOT as a hard failure.
GROK_API_KEY=
GROK_MODEL=grok-2-latest
GROK_API_URL=https://api.x.ai/v1/chat/completions

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# --- LLM behaviour ---
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

# --- Batch processing ---
BATCH_CONCURRENCY=3

# --- Frontend (Vite uses VITE_ prefix to expose to client) ---
# Only safe, non-secret values may use the VITE_ prefix.
VITE_API_BASE_URL=/api
